{
  "name": "islanders",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,yellow \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "wrangler dev --ip 127.0.0.1 --port 8787 --var DEV_MODE:true",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build",
    "check": "npm run test && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy:server": "npm run build && wrangler deploy",
    "deploy": "npm run check && wrangler deploy",
    "share": "node scripts/share.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0",
    "ws": "^8.22.0"
  }
}
