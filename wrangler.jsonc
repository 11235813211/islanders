{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "play",
  "main": "server/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      },
      {
        "name": "ACCOUNTS",
        "class_name": "AccountStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AccountStore"]
    }
  ],
  "ratelimits": [
    {
      "name": "ROOM_CREATION_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "CONNECTION_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "vars": {
    // Same-origin hosting is allowed automatically; add exact origins only for a separate frontend.
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
    "DEV_MODE": "false",
    // Account usernames (comma-separated) that may create solo test rooms in production.
    "PLAYTEST_USERS": "BentoBox"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
