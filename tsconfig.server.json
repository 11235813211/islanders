{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "ESNext",
    "moduleResolution": "Bundler", "skipLibCheck": true, "strict": true,
    "noEmit": true, "verbatimModuleSyntax": true, "types": ["@cloudflare/workers-types", "node"],
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["server", "shared"]
}
